clear
clc
close all

%% Загрузка данных
M = readmatrix('BSFC.xlsx');
rpm    = M(:,1);
torque = M(:,2);
bsfc   = M(:,3);

%% Сортировка точек по углу на каждой линии уровня
uniqueLevels = unique(bsfc);
rpm_sorted = [];
torque_sorted = [];
bsfc_sorted = [];

for i = 1:length(uniqueLevels)
    level = uniqueLevels(i);
    idx = bsfc == level;
    x = rpm(idx);
    y = torque(idx);
    
    % центр линии
    xc = mean(x); yc = mean(y);
    angles = atan2(y - yc, x - xc);
    
    [~, order] = sort(angles);
    
    rpm_sorted    = [rpm_sorted; x(order)];
    torque_sorted = [torque_sorted; y(order)];
    bsfc_sorted   = [bsfc_sorted; repmat(level, length(order), 1)];
end

%% Сетка для интерполяции
[n, T] = meshgrid(linspace(0,5500,200), linspace(0,150,200));

%% Интерполяция с griddata
BSFC = griddata(rpm_sorted, torque_sorted, bsfc_sorted, n, T, 'linear'); % 'linear' или 'natural'

%% 3D поверхность
figure
surf(n, T, BSFC, 'EdgeColor','none')
xlabel('n (rpm)')
ylabel('T (Nm)')
zlabel('BSFC')
title('BSFC surface via griddata')
colorbar
view(45,30)
shading interp
hold on

%% Красные линии исходных контуров
for i = 1:length(uniqueLevels)
    level = uniqueLevels(i);
    idx = bsfc == level;
    x = rpm(idx);
    y = torque(idx);
    
    % сортировка по углу
    xc = mean(x); yc = mean(y);
    angles = atan2(y - yc, x - xc);
    [~, order] = sort(angles);
    
    plot3(x(order), y(order), repmat(level, size(x)), 'r-', 'LineWidth', 1)
end

%% Контурная карта
figure
contourf(n, T, BSFC, 30, 'LineColor', 'none')
hold on
contour(n, T, BSFC, 30, 'k', 'LineWidth', 0.8)

for i = 1:length(uniqueLevels)
    level = uniqueLevels(i);
    idx = bsfc == level;
    x = rpm(idx);
    y = torque(idx);
    
    % сортировка по углу
    xc = mean(x); yc = mean(y);
    angles = atan2(y - yc, x - xc);
    [~, order] = sort(angles);
    
    plot(x(order), y(order), 'r-', 'LineWidth', 1)
end

xlabel('n (rpm)')
ylabel('T (Nm)')
title('BSFC map via griddata with original contours')
colorbar
grid on