%% Построение поверхности по линиям уровня
clear; clc; close all;

%% 1. Загрузка данных из Excel
fprintf('Загрузка данных из BSFC.xlsx...\n');
data = readtable('BSFC.xlsx');

x = data{:, 1};
y = data{:, 2};
z = data{:, 3};

valid_idx = ~isnan(x) & ~isnan(y) & ~isnan(z);
x = x(valid_idx);
y = y(valid_idx);
z = z(valid_idx);

fprintf('Загружено точек: %d\n', length(x));

%% 2. Группировка по уровням
unique_levels = unique(z);
unique_levels = sort(unique_levels);
n_levels = length(unique_levels);

fprintf('Найдено уровней: %d\n', n_levels);

% Ячейки для хранения точек каждого уровня
level_points = cell(n_levels, 1);

for i = 1:n_levels
    level_idx = abs(z - unique_levels(i)) < 0.5;
    level_points{i} = [x(level_idx), y(level_idx)];
    fprintf('Уровень %d (z=%.1f): %d точек\n', i, unique_levels(i), size(level_points{i}, 1));
end

%% 3. Упорядочивание и принудительное замыкание контуров
ordered_contours = cell(n_levels, 1);
for i = 1:n_levels
    points = level_points{i};
    n = size(points, 1);
    
    if n == 1
        % Контур из одной точки - просто сохраняем
        ordered_contours{i} = points;
        fprintf('  Контур %d (точка): 1 точка\n', i);
    elseif n >= 3
        % Находим центроид
        centroid = mean(points, 1);
        
        % Сортируем по углу
        angles = atan2(points(:,2) - centroid(2), points(:,1) - centroid(1));
        [~, idx] = sort(angles);
        ordered = points(idx, :);
        
        % Замыкаем контур
        ordered_contours{i} = [ordered; ordered(1,:)];
        fprintf('  Контур %d замкнут: %d точек\n', i, size(ordered_contours{i}, 1));
    else
        ordered_contours{i} = points;
        fprintf('  Контур %d: %d точек (не замыкаем)\n', i, n);
    end
end

%% 4. Построение поверхности
all_vertices = [];
all_triangles = [];

for level_idx = 1:n_levels-1
    fprintf('\nСоединяем уровни %.0f и %.0f...\n', unique_levels(level_idx), unique_levels(level_idx+1));
    
    % Получаем контуры
    c1 = ordered_contours{level_idx};
    c2 = ordered_contours{level_idx+1};
    
    % Для контура с одной точкой не убираем последнюю точку
    if size(c1, 1) > 1 && size(c1, 1) == size(unique(c1, 'rows'), 1) + 1
        % Контур замкнут - убираем последнюю точку
        c1_clean = c1(1:end-1, :);
    else
        c1_clean = c1;
    end
    
    if size(c2, 1) > 1 && size(c2, 1) == size(unique(c2, 'rows'), 1) + 1
        c2_clean = c2(1:end-1, :);
    else
        c2_clean = c2;
    end
    
    z1 = unique_levels(level_idx);
    z2 = unique_levels(level_idx+1);
    
    % Добавляем Z-координаты
    c1_3d = [c1_clean, ones(size(c1_clean,1),1)*z1];
    c2_3d = [c2_clean, ones(size(c2_clean,1),1)*z2];
    
    % Строим триангуляцию
    [verts, tris] = connect_contours_simple(c1_3d, c2_3d);
    
    % Добавляем к общему набору
    if ~isempty(verts) && ~isempty(tris)
        if isempty(all_vertices)
            offset = 0;
        else
            offset = size(all_vertices, 1);
        end
        
        all_vertices = [all_vertices; verts];
        all_triangles = [all_triangles; tris + offset];
    end
end

%% 5. Визуализация
figure('Position', [100, 100, 1400, 600]);

if ~isempty(all_triangles)
    trisurf(all_triangles, all_vertices(:,1), all_vertices(:,2), all_vertices(:,3), ...
        'FaceColor', [0.3 0.7 0.3], ...
        'EdgeColor', 'k', ...
        'LineWidth', 0.5, ...
        'FaceAlpha', 0.9);
    
    xlabel('X'); ylabel('Y'); zlabel('Z');
    title('3D поверхность');
    axis tight;
    grid on;
    view(3);
end

% Сохраняем триангуляцию
save('BSFC_surface.mat', 'all_vertices', 'all_triangles');
fprintf('  Создан файл: BSFC_surface.mat\n');

%% ========== ФУНКЦИЯ СОЕДИНЕНИЯ КОНТУРОВ ==========

function [vertices, triangles] = connect_contours_simple(c1, c2)
    % Соединение двух контуров с поддержкой контуров-точек
    
    n1 = size(c1, 1);
    n2 = size(c2, 1);
    
    fprintf('    Соединяем %d и %d точек\n', n1, n2);
    
    % Особый случай: первый контур - точка
    if n1 == 1 && n2 >= 3
        fprintf('    Первый контур - точка, строим веер\n');
        
        vertices = [c1; c2];
        triangles = [];
        
        % Строим веер от точки ко всем ребрам второго контура
        for i = 1:n2-1
            triangles = [triangles; 1, i+1, i+2];
        end
        % Замыкающий треугольник
        triangles = [triangles; 1, n2+1, 2];
        
        fprintf('    Построено %d треугольников\n', size(triangles, 1));
        return;
    end
    
    % Особый случай: второй контур - точка
    if n2 == 1 && n1 >= 3
        fprintf('    Второй контур - точка, строим веер\n');
        
        vertices = [c1; c2];
        triangles = [];
        
        % Строим веер от точки ко всем ребрам первого контура
        for i = 1:n1-1
            triangles = [triangles; i, i+1, n1+1];
        end
        % Замыкающий треугольник
        triangles = [triangles; n1, 1, n1+1];
        
        fprintf('    Построено %d треугольников\n', size(triangles, 1));
        return;
    end
    
    % Если недостаточно точек
    if n1 < 3 || n2 < 3
        fprintf('    Недостаточно точек для построения поверхности\n');
        vertices = [c1; c2];
        triangles = [];
        return;
    end
    
    % Обычный случай - два нормальных контура
    fprintf('Два нормальных контура\n');
    
    % Находим начальное соответствие
    dist = pdist2(c1(:,1:2), c2(:,1:2));
    [~, min_idx] = min(dist(:));
    [i0, j0] = ind2sub([n1, n2], min_idx);
    
    % Сдвигаем второй контур
    c2 = circshift(c2, -(j0-1), 1);
    
    % Создаем вершины
    vertices = [c1; c2];
    idx1 = 1:n1;
    idx2 = n1 + (1:n2);
    
    % Соединяем контуры
    triangles = [];
    i = i0;
    j = 1;
    
    % Счетчики пройденных точек
    count1 = 0;
    count2 = 0;
    max_iter = (n1 + n2) * 2;
    iter = 0;
    
    while (count1 < n1 || count2 < n2) && iter < max_iter
        iter = iter + 1;
        
        i_next = mod(i, n1) + 1;
        j_next = mod(j, n2) + 1;
        
        % Если один контур полностью пройден
        if count1 >= n1
            triangles = [triangles; idx1(i), idx2(j), idx2(j_next)];
            j = j_next;
            count2 = count2 + 1;
            continue;
        end
        
        if count2 >= n2
            triangles = [triangles; idx1(i), idx1(i_next), idx2(j)];
            i = i_next;
            count1 = count1 + 1;
            continue;
        end
        
        % Оба контура еще не пройдены - выбираем по расстоянию
        d1 = norm(c1(i_next,1:2) - c2(j,1:2));
        d2 = norm(c1(i,1:2) - c2(j_next,1:2));
        
        if d1 < d2
            triangles = [triangles; idx1(i), idx1(i_next), idx2(j)];
            i = i_next;
            count1 = count1 + 1;
        else
            triangles = [triangles; idx1(i), idx2(j), idx2(j_next)];
            j = j_next;
            count2 = count2 + 1;
        end
    end
    
    % Добавляем замыкающие треугольники
    if i ~= i0 || j ~= 1
        triangles = [triangles; idx1(i), idx2(j), idx2(1)];
        triangles = [triangles; idx1(i0), idx1(i), idx2(1)];
    end
    
    % Удаляем дубликаты
    if ~isempty(triangles)
        triangles = unique(triangles, 'rows');
    end
    
    fprintf('    Построено %d треугольников\n', size(triangles, 1));
end